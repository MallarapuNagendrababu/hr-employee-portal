{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hr-employee-portal",
	"account_id": "7247c365052f5e672651e325b798babe",
	"main": "./backend/src/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./frontend/dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hr-employee-portal",
			"database_id": "1263a55d-2c99-4c92-bb54-f07c99835c39",
			"migrations_dir": "./backend/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "hr-employee-portal-documents"
		}
	],
	"observability": {
		"enabled": true
	}
}